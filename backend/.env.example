# Estructura de backend/.env — SIN valores reales.
# El .env real nunca se commitea (ver .gitignore y rules/security.md).

# --- Base de datos (obligatorio) --------------------------------------------
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Ingresos locales --------------------------------------------------------
INGRESOS_LOCALES_URL=

# --- Agrocalidad -------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=

# --- Inventario LAG (WMS de Logiztik Alliance) -------------------------------
LAG_ENV=test
LAG_CUSTOMER_CODE=
LAG_TOKEN=
LAG_SALES_API_KEY=
# Posteo de Inventario: token propio, distinto de LAG_TOKEN. Sin ambiente de
# pruebas: cada llamada crea una orden real.
LAG_PLACE_ORDER_TOKEN=

# --- Torre de Control --------------------------------------------------------
DEMO_MODE=true
REFRESH_SECONDS=300
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
DUOPLANE_API_KEY=
DUOPLANE_PASSWORD=

# --- Auditoria de Etiquetas --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# --- Proveedores (gateway movil de Logiztik) ---------------------------------
LOGIZTIK_MOBILE_BASE_URL=
LOGIZTIK_USER=
LOGIZTIK_PASS=
LOGIZTIK_ENTITY_ID=

# --- Armellini Post: aviso de despacho por correo ----------------------------
# Cuenta de Gmail que envia. GMAIL_APP_PASSWORD es una "contrasena de
# aplicacion" de 16 caracteres (https://myaccount.google.com/apppasswords),
# NO la clave de la cuenta; exige verificacion en dos pasos activa.
#
# OJO: el plan gratuito de Render bloquea los puertos SMTP 25, 465 y 587,
# asi que esto funciona en local pero no en produccion mientras BLIS siga
# en plan free. Ver la deuda tecnica en CLAUDE.md.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=BLIS
