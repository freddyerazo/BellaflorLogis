# Estructura de backend/.env — SIN valores reales.
# El .env real nunca se commitea (ver .gitignore y rules/security.md).

# --- Base de datos (obligatorio) --------------------------------------------
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Ingresos locales --------------------------------------------------------
INGRESOS_LOCALES_URL=

# --- Entregas Locales (cruce recibos OCR vs dartis_ventas) -------------------
# Modulo nuevo (2026-09-06), separado de Ingresos Locales de arriba. Reinterpreta
# el texto OCR crudo del mismo Sheet con Claude en vez del JSON que ya arma el
# bot original (deepseek-chat), para tener datos mas limpios y relacionales.
# Clave: console.anthropic.com -> API Keys. Nunca commitear el valor real.
ANTHROPIC_API_KEY=
# Fijo en vez de "latest": un cambio de modelo silencioso podria alterar el
# formato de salida sin que nadie lo note. Subir a mano cuando se decida
# migrar, no automaticamente.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Respaldo/comparacion mientras se carga credito en Anthropic: es la MISMA
# cuenta que ya usa el bot original (script.google.com del proyecto
# IngresosLocales -> Project Settings -> Script Properties -> DEEPSEEK_KEY).
# API compatible con OpenAI (se usa el SDK "openai" apuntando a su base_url).
DEEPSEEK_API_KEY=
# Tercera opcion para comparar calidad de extraccion. Clave: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Lectura directa del Google Sheet del bot (cuenta de servicio de solo
# lectura). El .json se comparte con el Sheet como Lector; nunca al repo.
ENTREGAS_LOCALES_SHEET_ID=
ENTREGAS_LOCALES_SA_JSON=google-sheets-sa.json
ENTREGAS_LOCALES_HOJA=Hoja 1

# --- Agrocalidad -------------------------------------------------------------
# Sin credenciales: consulta la API publica de la app AGRO Movil.

# --- Inventario LAG (WMS de Logiztik Alliance) -------------------------------
LAG_ENV=test
LAG_CUSTOMER_CODE=
LAG_TOKEN=
LAG_SALES_API_KEY=
# Posteo de Inventario: token propio, distinto de LAG_TOKEN. Sin ambiente de
# pruebas: cada llamada crea una orden real.
LAG_PLACE_ORDER_TOKEN=
LAG_PLACE_ORDER_BASE_URL=
LAG_TIMEOUT=30

# --- Torre de Control --------------------------------------------------------
DEMO_MODE=true
REFRESH_SECONDS=300
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
DUOPLANE_API_KEY=
DUOPLANE_API_PASSWORD=
# URLs base: solo para apuntar a sandbox; en blanco usan produccion.
DUOPLANE_BASE_URL=
UPS_BASE_URL=
FEDEX_BASE_URL=
# Hoja de entregas locales (agencias que no son UPS/FedEx)
GOOGLE_SHEETS_API_KEY=
ENTREGAS_SHEET_URL=

# --- Auditoria de Etiquetas --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Las fotos suben via Apps Script, no con cuenta de servicio: el endpoint
# publicado y el secreto compartido que valida las llamadas.
GOOGLE_DRIVE_UPLOAD_URL=
GOOGLE_DRIVE_UPLOAD_SECRET=

# --- Proveedores (gateway movil de Logiztik) ---------------------------------
LOGIZTIK_MOBILE_BASE_URL=
LOGIZTIK_USER=
LOGIZTIK_PASS=
LOGIZTIK_ENTITY_ID=
LOGIZTIK_TIMEOUT=30
LOGIZTIK_LOGIN_MINUTOS=50

# --- Armellini Post: pre-alerta de despacho por correo ------------------------
# Se usa la API de Gmail sobre HTTPS, no SMTP: el plan gratuito de Render
# bloquea los puertos SMTP 25/465/587, y la API va por el 443.
#
# Se obtienen una sola vez con:  cd backend && python scripts/gmail_autorizar.py
# (ese script explica como crear el cliente OAuth en Google Cloud Console).
#
# El permiso pedido es gmail.send: permite ENVIAR, no leer el buzon.
# Si el proyecto de Google Cloud sigue en modo "Testing", Google caduca el
# refresh token a los 7 dias: hay que PUBLICAR la app para uso permanente.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
MAIL_FROM_NAME=BLIS
GMAIL_TIMEOUT=30

# --- Acceso a la API ---------------------------------------------------------
# BLIS no tiene login todavia: en produccion cualquiera con la URL puede leer
# y escribir. BLIS_API_KEY exige la cabecera X-API-Key en POST/PUT/PATCH/DELETE
# (el webhook de Telegram queda exento: ya trae su propio secreto).
#
# En blanco no exige nada, que es como esta hoy. ATENCION antes de activarla:
# el frontend NO envia esa cabecera, asi que al ponerla se dejaran de poder
# guardar datos desde la interfaz. Sirve para integraciones maquina a maquina;
# proteger el frontend requiere autenticacion de verdad (ver deuda tecnica).
BLIS_API_KEY=

# Origenes permitidos por CORS, separados por coma. El frontend se sirve desde
# el mismo origen que la API, asi que en blanco (default) ya funciona.
CORS_ORIGINS=
